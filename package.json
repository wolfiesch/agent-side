{
	"name": "@wolfiesch/side",
	"version": "0.1.0",
	"description": "Fork a running coding-agent session into a nearby terminal pane: Claude Code, Codex, and omp, in tmux, Tern, WezTerm, Kitty, cmux, or Ghostty",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfiesch/agent-side.git"
	},
	"type": "module",
	"engines": {
		"bun": ">=1.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"side": "./src/cli.ts"
	},
	"scripts": {
		"test": "bun test",
		"check": "tsc -p ."
	},
	"keywords": [
		"claude-code",
		"codex",
		"omp",
		"oh-my-pi",
		"coding-agent",
		"session-fork",
		"tmux",
		"tern",
		"wezterm",
		"kitty",
		"cmux",
		"ghostty"
	],
	"files": ["src/*.ts", "!src/*.test.ts", "README.md", "LICENSE"],
	"devDependencies": {
		"@types/bun": "^1.4.3",
		"typescript": "^7.0.2"
	}
}
