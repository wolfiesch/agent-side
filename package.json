{
	"name": "agent-side",
	"version": "0.1.0",
	"description": "Fork a running coding-agent session into a nearby terminal pane: Claude Code and Codex, in tmux, Tern, WezTerm, Kitty, cmux, or Ghostty",
	"license": "MIT",
	"type": "module",
	"bin": {
		"side": "./src/cli.ts"
	},
	"scripts": {
		"test": "bun test",
		"check": "tsc -p ."
	},
	"keywords": [
		"claude-code",
		"codex",
		"coding-agent",
		"session-fork",
		"tmux",
		"tern",
		"wezterm",
		"kitty",
		"cmux",
		"ghostty"
	],
	"files": ["src/*.ts", "!src/*.test.ts", "README.md", "LICENSE"],
	"devDependencies": {
		"@types/bun": "^1.4.3",
		"typescript": "^7.0.2"
	}
}
